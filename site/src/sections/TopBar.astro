---
import { SITE } from '../site.config';
import GitHubIcon from '../components/GitHubIcon.astro';
---
<header class="topbar" data-topbar>
  <div class="wrap topbar-in">
    <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>cue-2350 <span>mic</span></a>
    <nav class="topbar-nav label" aria-label="Sections">
      <a href="/#magic">how it works</a>
      <a href="/#why">why</a>
      <a href="/#get">get it</a>
    </nav>
    <a class="btn topbar-cta" href={SITE.github} target="_blank" rel="noopener noreferrer"><GitHubIcon /> github</a>
  </div>
</header>

<style>
  .topbar {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
    transform: translateY(-100%);
    transition: transform 0.5s var(--ease-out);
  }
  .topbar.show { transform: none; }
  .topbar-in { display: flex; align-items: center; gap: 24px; height: 60px; }
  .wordmark {
    font-weight: 900; font-size: 22px; letter-spacing: -0.04em; text-decoration: none; margin-right: auto;
  }
  .wordmark span { color: var(--accent); }
  .topbar-nav { display: flex; gap: 28px; }
  .topbar-nav a { text-decoration: none; color: #4a4a46; }
  .topbar-nav a:hover { color: var(--accent); }
  .topbar-cta { padding: 10px 14px; font-size: 12px; }
  @media (max-width: 720px) { .topbar-nav { display: none; } }
</style>
